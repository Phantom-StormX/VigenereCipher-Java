<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phantomstormx.vigenerecipherjava.VigenereController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Image at Top -->
    <!--    <ImageView fitHeight="150"-->
    <!--               fitWidth="150"-->
    <!--               preserveRatio="true">-->
    <!--        <image>-->
    <!--            <Image url="file:///var/folders/qq/03gytprn3y31573b5vl0jvm40000gp/T/TemporaryItems/NSIRD_screencaptureui_pKbhmM/Screenshot%202026-04-28%20at%2011.01.25.png" />-->
    <!--        </image>-->

    <!--    </ImageView>-->

    <!-- Title -->
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Vigenere Encoder / Decoder" />


    <Label text="Input Text:" />
    <TextArea fx:id="inputText" prefHeight="100" promptText="Enter Input Text Here." wrapText="true" />


    <HBox alignment="CENTER" spacing="10">
        <Label text="Key word:" />
        <TextField fx:id="keyField" prefWidth="80" promptText="Put key word Here" />
    </HBox>


    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="handleEncrypt" onAction="#handleEncrypt" text="Encode" />

        <Button fx:id="handleDecode" onAction="#handleDecode" text="Decode" />

        <Button fx:id="handleClear" onAction="#handleClear" text="Clear" />
    </HBox>


    <Label text="Output Text:" />
    <TextArea fx:id="outputText" editable="false" prefHeight="100" promptText="Output Text will Appear Here" wrapText="true" />

    <!-- Exit Button -->
    <Button fx:id="handleExit" onAction="#handleExit" prefWidth="100" text="Exit" />

   <effect>
      <SepiaTone level="0.23" />
   </effect>

</VBox>
